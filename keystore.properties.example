# Copy this file to keystore.properties (which is git-ignored) and fill in your upload keystore details.
# NEVER commit keystore.properties or your .jks/.keystore file to version control.
storeFile=keystore/vibe-chess-upload.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=vibe-chess-upload
keyPassword=CHANGE_ME_KEY_PASSWORD
