    <!-- How to Play Screen -->
    <string name="how_to_play_title">খেলার নিয়মাবলি</string>
    <string name="how_to_play_subtitle">চেক ও কিস্তিমাত ছাড়া দ্রুতগতির সময়ভিত্তিক দাবা</string>
    <string name="how_to_play_no_check_title">কোনো চেক বা কিস্তিমাত নেই</string>
    <string name="how_to_play_no_check_body">ঘুঁটির চাল সাধারণ দাবার মতোই (ক্যাসলিং, এন পাসান্ট ও বোড়ে প্রমোশনসহ)। তবে এখানে কোনো চেক বা কিস্তিমাত নেই — রাজা আক্রান্ত ঘরে যেতে পারে এবং যেকোনো ঘুঁটির মতোই রাজাকে ক্যাপচার করা যায়; রাজা কাটা গেলেও খেলা সাথে সাথে শেষ হয় না!</string>
    <string name="how_to_play_clock_title">সময় ও পয়েন্টের লড়াই</string>
    <string name="how_to_play_clock_body">প্রতি পক্ষ মোট 1 বা 2 মিনিট সময় পায় (কোনো অতিরিক্ত সময় যোগ হয় না)। যার চাল শুধু তার ঘড়িই চলে। যেকোনো এক পক্ষের সময় শূন্য (0) হওয়া মাত্র খেলা শেষ হয় এবং তখন বোর্ডে যার ঘুঁটির মোট পয়েন্ট বেশি থাকে সে জয়ী হয় (সমান পয়েন্ট হলে ড্র)।</string>
    <string name="how_to_play_points_title">ঘুঁটির পয়েন্ট মান</string>
    <string name="how_to_play_points_body">বোড়ে (Pawn) = 1  •  ঘোড়া (Knight) = 2  •  হাতি (Bishop) = 3\nনৌকা (Rook) = 4  •  মন্ত্রী (Queen) = 5  •  রাজা (King) = 7</string>
    <string name="how_to_play_special_title">জয়ের সম্ভাবনা ও বিশেষ নিয়ম</string>
    <string name="how_to_play_special_body">খেলা চলাকালীন সরাসরি পয়েন্ট দেখানো হয় না; বদলে জয়ের সম্ভাবনা বার (Win Probability Bar) দেখে বোঝা যায় কে এগিয়ে আছে। রাজা ও নৌকা না নড়ে থাকলে এবং মাঝের ঘর খালি থাকলে আক্রান্ত ঘরের ওপর দিয়েও ক্যাসলিং করা যায় (রাজা ক্যাপচার হলে ক্যাসলিংয়ের সুযোগ বাতিল হয়)। কোনো পক্ষের বৈধ চাল না থাকলে তার দান স্কিপ হয় কিন্তু তার ঘড়ি চলতে থাকে।</string>

