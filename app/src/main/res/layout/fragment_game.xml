<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/spacing_sm">

    <!-- Top Header Bar: Back Button, Active Turn Indicator, and Rotate Black Toggle -->
    <LinearLayout
        android:id="@+id/top_header_bar"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game_back"
            style="@style/Widget.VibeChess.Button.Surface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height_compact"
            android:text="@string/settings_back" />

        <TextView
            android:id="@+id/tv_turn_indicator"
            android:layout_width="@dimen/zero_dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/game_turn_white"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_section_label"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_rotate_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/game_rotate_black_pieces"
            android:textColor="@color/text"
            android:textSize="@dimen/text_caption"
            app:thumbTint="@color/primary" />

    </LinearLayout>

    <!-- Black Player Panel (Top: Player Label, Captured Tray Placeholder, Clock Placeholder) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_player_black"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/corner_radius_md"
        app:cardElevation="@dimen/zero_dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_header_bar"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="@dimen/stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="@dimen/zero_dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_player_black"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_section_label"
                    android:textStyle="bold" />

                <!-- Captured Tray Placeholder -->
                <LinearLayout
                    android:id="@+id/layout_captured_black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/captured_tray_min_height"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_captured_tray_placeholder"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Clock Placeholder -->
            <TextView
                android:id="@+id/tv_clock_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xxs"
                android:text="@string/game_clock_placeholder"
                android:textColor="@color/text"
                android:textSize="@dimen/text_clock"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Winning Probability Bar Placeholder -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_probability_bar"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/corner_radius_sm"
        app:cardElevation="@dimen/zero_dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_player_black"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="@dimen/stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xxs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/game_win_probability_placeholder"
                android:textColor="@color/text"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/prob_bar_height"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/primary" />

                <View
                    android:layout_width="@dimen/zero_dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/piece_black_fill" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Centered Square Chess BoardView -->
    <com.reduan.vibechess.ui.game.BoardView
        android:id="@+id/board_view"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="@dimen/zero_dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:contentDescription="@string/game_board_content_desc"
        app:layout_constraintBottom_toTopOf="@+id/card_player_white"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_probability_bar" />

    <!-- White Player Panel (Bottom: Player Label, Captured Tray Placeholder, Clock Placeholder) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_player_white"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/corner_radius_md"
        app:cardElevation="@dimen/zero_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="@dimen/stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="@dimen/zero_dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_player_white"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_section_label"
                    android:textStyle="bold" />

                <!-- Captured Tray Placeholder -->
                <LinearLayout
                    android:id="@+id/layout_captured_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/captured_tray_min_height"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_captured_tray_placeholder"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Clock Placeholder -->
            <TextView
                android:id="@+id/tv_clock_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xxs"
                android:text="@string/game_clock_placeholder"
                android:textColor="@color/text"
                android:textSize="@dimen/text_clock"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
