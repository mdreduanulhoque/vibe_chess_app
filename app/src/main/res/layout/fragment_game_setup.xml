<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:id="@+id/setup_content"
            android:layout_width="@dimen/zero_dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <!-- Top Bar: Back Button + Screen Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_back"
                    style="@style/Widget.VibeChess.Button.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height_compact"
                    android:text="@string/settings_back" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_title"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_screen_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_setup_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_subtitle_multiplayer"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Single Player Color Selection Card (White / Black / Random) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/zero_dp"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_color_label"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_section_label"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_color_choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_color_white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_color_white"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_color_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_color_black"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_color_random"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_color_random"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Single Player Difficulty Selection Card (Easy / Medium / Hard) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_difficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/zero_dp"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_difficulty_label"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_section_label"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_difficulty_choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_difficulty_easy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_difficulty_easy"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_difficulty_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_difficulty_medium"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_difficulty_hard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_difficulty_hard"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Time Selection Card (1 min or 2 min per side) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/zero_dp"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_time_label"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_section_label"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_time_choice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_time_1_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_time_1_min"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_time_2_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/setup_time_2_min"
                            android:textColor="@color/text"
                            app:buttonTint="@color/primary" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rotate Opponent Pieces Setting Card (Multiplayer Pass-and-Play only) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_rotate_opponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/zero_dp"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_rotate_opponent_label"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_section_label"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_setup_rotate_opponent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/setup_rotate_opponent_label"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        app:thumbTint="@color/primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Start Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_game"
                style="@style/Widget.VibeChess.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/setup_start_game" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
