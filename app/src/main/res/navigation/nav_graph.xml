<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.reduan.vibechess.ui.splash.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.reduan.vibechess.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_setup"
            app:destination="@id/gameSetupFragment" />
        <action
            android:id="@+id/action_home_to_game"
            app:destination="@id/gameFragment" />
        <action
            android:id="@+id/action_home_to_how_to_play"
            app:destination="@id/howToPlayFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/gameSetupFragment"
        android:name="com.reduan.vibechess.ui.setup.GameSetupFragment"
        android:label="@string/setup_title"
        tools:layout="@layout/fragment_game_setup">
        <action
            android:id="@+id/action_setup_to_game"
            app:destination="@id/gameFragment"
            app:popUpTo="@id/gameSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/gameFragment"
        android:name="com.reduan.vibechess.ui.game.GameFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_game">
        <action
            android:id="@+id/action_game_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/gameFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.reduan.vibechess.ui.result.ResultFragment"
        android:label="@string/result_title"
        tools:layout="@layout/fragment_result">
        <action
            android:id="@+id/action_result_to_game"
            app:destination="@id/gameFragment"
            app:popUpTo="@id/resultFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_result_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/howToPlayFragment"
        android:name="com.reduan.vibechess.ui.howtoplay.HowToPlayFragment"
        android:label="@string/how_to_play_title"
        tools:layout="@layout/fragment_how_to_play" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.reduan.vibechess.ui.settings.SettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_settings" />

</navigation>
