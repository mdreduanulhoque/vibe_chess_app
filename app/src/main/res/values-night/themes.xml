<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Theme Overrides -->
    <style name="Theme.VibeChess" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/onPrimary</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Apply bundled Bangla + Latin font globally -->
        <item name="android:fontFamily">@font/noto_sans_bengali_family</item>
        <item name="fontFamily">@font/noto_sans_bengali_family</item>
    </style>
</resources>
